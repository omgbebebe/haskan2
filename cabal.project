packages:
  ./
  ./3rdparty/fir/
  ./3rdparty/gltf-loader/
  ./3rdparty/dear-imgui/

write-ghc-environment-files: always

package dear-imgui
  flags: +sdl +vulkan -opengl3 -glfw +use-wchar32 +use-imdrawidx32

package fir
  flags: +internals

allow-newer:
  dear-imgui:megaparsec
  , boring:base
  , constraints-extras:base
  , *:base
  , *:template-haskell
  , *:containers
  , *:ghc-bignum
  , gltf-codec:aeson
  , gltf-loader:aeson
  , monad-control:transformers-compat
