packages:
  ./
  ./3rdparty/fir/
  ./3rdparty/gltf-loader/

write-ghc-environment-files: always

allow-newer:
  boring:base
  , constraints-extras:base
  , *:base
  , *:template-haskell
  , *:containers
  , *:ghc-bignum
  , gltf-codec:aeson
  , gltf-loader:aeson
  , monad-control:transformers-compat
